// 핀프렌즈 데이터 모델
//
// 근거 — SRS §6.2 데이터 모델 · [Diagrams] ERD · DAT-001 · DAT-002 · INF-003
//
// 🔴 이 파일은 규제 항목 4가지를 **구조로** 지킨다. 나중에 고칠 수 있는 것이 아니다.
//   ① 스키마 2분할  identity(식별정보) / activity(학습·실천) — 결합 조회 0건 (REQ-NF-009 · S3)
//   ② 금지 필드 부재 좌표 0 · 얼굴 이미지 0 (REQ-TEC-009 · S1 · S2)
//   ③ 별↔저금통 전환 경로 부재 — 전환 필드·심볼 0건 (P-21 · S4)
//   ④ 멱등 키       별 원장·이벤트에 unique — 중복 지급 0건 (REQ-NF-006 · REQ-TEC-011)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 🔴 접속 URL 은 여기 두지 않는다 — Prisma 7 부터 `prisma.config.ts` 가 갖는다.
  //    앱은 풀러(트랜잭션 모드), 마이그레이션은 직결로 나눈다.
  //    같은 커넥션을 쓰면 풀러의 트랜잭션 모드에서 마이그레이션이 깨진다 (ADR-T04 · REQ-TEC-005)
  // 🔴 `dev_auth` 는 로컬 전용이다. Supabase 이관 때 이 배열에서 빼고 스키마를 버린다 (CON-001)
  schemas = ["identity", "activity", "dev_auth"]
}

// ─────────────────────────────────────────────────────────────
// 열거형 — SRS §6.2. 값을 늘리면 화면·판정·계측 세 곳이 함께 바뀐다
// ─────────────────────────────────────────────────────────────

/// 학습·나무·실천이 공유하는 고정 4영역 (§6.2.1)
enum LearningTopic {
  EARN
  SPEND
  SAVE
  GROW

  @@schema("activity")
}

/// ⭐ 지급 트리거 8종 (§6.2.2). 코드가 곧 WPA 분모/분자 구분의 근거다
enum StarTrigger {
  ONBOARDING_LEARN
  ATTENDANCE
  QUIZ_CORRECT
  MISSION_APPROVED
  SPENDING_RETRO
  WISHLIST_REACHED
  SAVINGS_JOINED
  SAVINGS_DONE
  /// 🔴 SRS §6.2.2 에 없던 코드 — 어긋남 대장 D8.
  ///    `REQ-FUNC-004` 가 「별은 차감형」이라 하고 `STR-003` 이 「옷장 차감 기입」을 요구하는데
  ///    트리거 8종이 전부 지급용이라 차감을 적을 자리가 없었다.
  ///    나가는 곳은 **앱 내 재화뿐**이다 — P-21(현금·저금통 분리)은 그대로다
  WARDROBE_SPEND

  @@schema("activity")
}

/// 경로 구분이 **북극성 지표 산출의 기준**이다.
/// 학습 경로를 분자에 넣으면 접속만으로 오르는 활동량 지표로 퇴화한다 (§6.2.2)
enum TriggerPath {
  LEARNING
  PRACTICE

  @@schema("activity")
}

/// 미션 승인 상태 (§6.2.4).
/// BACKFILLED = ⭐는 지급하되 나무 조건은 **완료 시점 주기**에 귀속 (ACE-6.2)
enum ApprovalState {
  PENDING
  APPROVED
  BACKFILLED
  REJECTED

  @@schema("activity")
}

/// 계획↔실제 판정 (§6.2.5). ⭐ 판정은 **금액 단독**이다 (ADR-008)
enum PlanMatchResult {
  MET
  EXCEEDED
  NO_PLAN

  @@schema("activity")
}

/// 업종 일치는 회고 문장을 분기하는 **관측 항목**이며 ⭐를 차단하지 않는다
enum CategoryMatch {
  MATCHED
  MISMATCHED

  @@schema("activity")
}

/// 계획 카드를 적은 주체 — 보호자가 대신 적어도 기록에 남는다
enum PlanAuthor {
  GUARDIAN
  CHILD

  @@schema("activity")
}

/// 기기 모드 — 🔴 SRS 에 없던 개념. 어긋남 대장 D5 참조.
///
/// `REQ-NF-011`(아동 독립 자격증명 없음)을 지키면서 **아이 폰에서 아이 화면만 열리게** 하는 장치다.
/// 아이 기기에도 살아 있는 것은 **보호자 세션**이므로, 막지 않으면 아이가 승인·결제 화면에 들어간다.
enum DeviceMode {
  /// 보호자 기기 — 전 화면
  GUARDIAN
  /// 아이 기기 — `/parent/**` 를 **서버가 차단**한다. 해제는 보호자 PIN
  CHILD

  @@schema("identity")
}

/// 동의·계정 상태 (SM-01). 아동 화면은 ACTIVE 에서만 열린다
enum AccountState {
  CREATED
  CONSENT_PENDING
  ACTIVE
  BLOCKED
  TERMINATED

  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────
// identity 스키마 — 아동 식별정보. activity 와 **조인하지 않는다**
// ─────────────────────────────────────────────────────────────

model GuardianAccount {
  id               String    @id @default(uuid()) @db.Uuid
  /// Supabase Auth 사용자 참조. 비밀번호·이메일을 여기 복제하지 않는다
  authRef          String    @unique @map("auth_ref")
  /// 🔴 법정대리인 동의. 서버가 판정하며 클라이언트가 캐시하지 않는다 (ACE-8.2 · S6)
  consentCompleted Boolean   @default(false) @map("consent_completed")
  consentAt        DateTime? @map("consent_at") @db.Timestamptz(6)
  /// 알림 발송 허용 시간대 — "21:00-08:00" 형식
  notifyWindow     String?   @map("notify_window")
  /// 🔴 아동 모드를 **푸는** 열쇠. 해시만 저장한다 (D5)
  ///    재로그인이 아니라 PIN 인 이유 — 아이 폰에서 보호자 비밀번호를 매번 치게 하면
  ///    아이가 그 비밀번호를 알게 된다
  childModePinHash String?   @map("child_mode_pin_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  children ChildAccount[]
  devices  DeviceSession[]

  @@map("guardian_accounts")
  @@schema("identity")
}

model ChildAccount {
  id         String       @id @default(uuid()) @db.Uuid
  guardianId String       @map("guardian_id") @db.Uuid
  /// 이름은 화면 표기용 최소 항목. 실명 확인 대상이 아니다
  displayName String      @map("display_name")
  /// 생년만 받는다. 생년월일 전체를 받지 않는다 (수집 최소화)
  birthYear  Int          @map("birth_year")
  /// 모집 분류 전용. 기기 식별자가 아니다
  deviceType String?      @map("device_type")
  state      AccountState @default(CONSENT_PENDING)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  guardian GuardianAccount @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  // 🔴 activity 쪽으로 가는 관계를 **의도적으로 두지 않는다.**
  //    Prisma 관계를 걸면 조인이 가능해지고 REQ-NF-009(결합 조회 0건)가 깨진다.
  //    화면이 이름을 필요로 하면 **애플리케이션 계층에서 합친다** (ADR-T03).

  @@index([guardianId])
  @@map("child_accounts")
  @@schema("identity")
}

/// 기기 등록 — 🔴 SRS 에 없던 표 (D5).
///
/// 「이 기기는 아이 것」을 **서버가 안다.** 쿠키만으로 두면 지우면 그만이다.
/// `S5` 감사가 「아동 모드 기기에서 보호자 경로 시도」를 여기서 센다.
model DeviceSession {
  id         String     @id @default(uuid()) @db.Uuid
  guardianId String     @map("guardian_id") @db.Uuid
  /// 기기를 가리키는 무작위 값. 기기 고유 식별자를 수집하지 않는다
  deviceRef  String     @unique @map("device_ref")
  mode       DeviceMode @default(GUARDIAN)
  /// 아동 모드일 때 이 기기가 여는 아이. GUARDIAN 모드면 null
  childId    String?    @map("child_id") @db.Uuid
  /// 보호자 경로 진입 시도 누적 — 1건 이상이면 S5 알림 대상
  blockedAttempts Int   @default(0) @map("blocked_attempts")

  /// 🔴 기기 토큰의 **해시**. 원문은 쿠키에만 있고 서버에 남기지 않는다
  ///    이 토큰은 `/child/**` 만 연다. 보호자 권한을 전혀 갖지 않는다
  tokenHash  String?    @unique @map("token_hash")
  /// 보호자 세션보다 **길다.** 부모가 옆에 없어도 아이가 계속 쓸 수 있어야 한다
  expiresAt  DateTime?  @map("expires_at") @db.Timestamptz(6)
  /// 보호자가 「이 기기 해제」를 누른 시각. 값이 있으면 즉시 무효다
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(6)

  lastSeenAt DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  guardian GuardianAccount @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
  @@map("device_sessions")
  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────
// activity 스키마 — 학습·실천·별·나무·숲·계획·소비·위시리스트·이벤트
//
// 🔴 childId 는 **FK 가 아니다.** identity 와 관계를 걸지 않기 위한 의도적 선택이다.
//    참조 무결성은 애플리케이션 계층과 해지 배치가 책임진다.
// ─────────────────────────────────────────────────────────────

model LearningProgress {
  id             String        @id @default(uuid()) @db.Uuid
  childId        String        @map("child_id") @db.Uuid
  topic          LearningTopic
  completedCount Int           @default(0) @map("completed_count")
  quizCorrect    Int           @default(0) @map("quiz_correct")
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([childId, topic])
  @@map("learning_progress")
  @@schema("activity")
}

/// 미션 — PRC-001.
///
/// 🔴 **아이가 하고 보호자가 승인한다.** 이 표가 없으면 부모 화면의 「승인 대기 N건」이
///    영원히 0이고, 별을 받는 주된 길(MISSION_APPROVED)이 막힌다.
///
/// 🔴 `cycleId` 는 **완료 시점 주기**다. 지연 승인이 다음 주기 나무를 부풀리지 않게(ACE-6.2).
model Mission {
  id          String        @id @default(uuid()) @db.Uuid
  childId     String        @map("child_id") @db.Uuid
  /// 만든 사람 — 보호자가 조건·보상을 미리 정한다 (PRC-001)
  guardianId  String        @map("guardian_id") @db.Uuid
  title       String
  topic       LearningTopic
  /// 지급할 별. 보호자가 미리 정한다
  reward      Int           @default(1)
  state       ApprovalState @default(PENDING)
  /// 아이가 「했어요」를 누른 시각. null 이면 아직 안 함
  doneAt      DateTime?     @map("done_at") @db.Timestamptz(6)
  /// 보호자가 승인·거절한 시각
  decidedAt   DateTime?     @map("decided_at") @db.Timestamptz(6)
  /// 거절 사유 — 「미실천」과 구별해 보여준다
  rejectReason String?      @map("reject_reason")
  /// 완료 시점 주기. 승인이 늦어도 이 주기에 귀속된다
  cycleId     Int?          @map("cycle_id")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([childId, state])
  @@index([guardianId, state])
  @@map("missions")
  @@schema("activity")
}

/// 실천 인정. 나무 승급의 **유일한** 근거다 — 학습·퀴즈로는 대체되지 않는다 (ADR-006)
model PracticeCredit {
  id           String      @id @default(uuid()) @db.Uuid
  childId      String      @map("child_id") @db.Uuid
  triggerCode  StarTrigger @map("trigger_code")
  triggerPath  TriggerPath @map("trigger_path")
  topic        LearningTopic?
  /// auto = 자동 판정 · parent = 보호자 승인
  approvalMode String      @map("approval_mode")
  /// 아이가 **실제로 한** 시각
  earnedAt     DateTime    @map("earned_at") @db.Timestamptz(6)
  /// ⭐가 **확정된** 시각. 소급 승인이면 둘이 다르다
  awardedAt    DateTime    @map("awarded_at") @db.Timestamptz(6)
  /// 🔴 귀속 주기를 별도 컬럼으로 둔다. 지급 시각으로 계산하면
  ///    소급 승인이 **다음 주기 나무를 부풀린다** (ACE-6.2)
  cycleId      Int         @map("cycle_id")

  starEntry StarLedgerEntry?

  @@index([childId, cycleId])
  @@index([childId, earnedAt])
  @@map("practice_credits")
  @@schema("activity")
}

/// 별 원장. 잔액을 따로 두지 않고 **원장의 합**이 잔액이다 — 정합성 오류율 0% (REQ-NF-006)
model StarLedgerEntry {
  id           String      @id @default(uuid()) @db.Uuid
  childId      String      @map("child_id") @db.Uuid
  /// 증감. 옷장 구매는 음수. 🔴 **현금·저금통으로 나가는 값은 없다** (P-21)
  delta        Int
  triggerCode  StarTrigger @map("trigger_code")
  /// 기입 직후 잔액 — 정합성 검사가 이 값과 누적합을 대조한다
  balanceAfter Int         @map("balance_after")
  /// 🔴 중복 지급 0건을 보증하는 유일한 장치. 오프라인 큐가 재전송해도 한 번만 들어간다
  idempotencyKey String    @unique @map("idempotency_key")
  practiceId   String?     @unique @map("practice_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  practice PracticeCredit? @relation(fields: [practiceId], references: [id])

  @@index([childId, createdAt])
  @@map("star_ledger")
  @@schema("activity")
}

/// 영역당 1행 = 아동당 4행. 주기마다 초기화되는 것은 **나무뿐**이다
model TreeState {
  id            String        @id @default(uuid()) @db.Uuid
  childId       String        @map("child_id") @db.Uuid
  slot          LearningTopic
  /// 🔴 단계 수는 **D6 미결**이다. 정수로 두고 판정 로직이 상한을 갖는다
  stage         Int           @default(0)
  condLearn     Boolean       @default(false) @map("cond_learn")
  condQuiz      Boolean       @default(false) @map("cond_quiz")
  /// 이 값이 0이면 학습·퀴즈를 초과 충족해도 승급하지 않는다
  practiceCount Int           @default(0) @map("practice_count")
  cycleStartedAt DateTime     @map("cycle_started_at") @db.Date
  /// 14일이면 정체. 원인은 조건 단위로 **전부** 표시한다 (ACE-3.1)
  stallDays     Int           @default(0) @map("stall_days")
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([childId, slot])
  @@map("tree_states")
  @@schema("activity")
}

/// 월간 숲. 나무와 달리 **초기화되지 않는다** — 누적 증거다
model ForestSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  childId      String   @map("child_id") @db.Uuid
  /// "2026-03"
  yearMonth    String   @map("year_month")
  finalStages  Json     @map("final_stages")
  /// 전월 대비 델타 7항목 (REQ-FUNC-009)
  deltaItems   Json     @map("delta_items")
  /// 별을 즉시 소진하는 아이에게 **유일한 누적 증거**다 (AC-1.4)
  starsEarned  Int      @map("stars_earned")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([childId, yearMonth])
  @@map("forest_snapshots")
  @@schema("activity")
}

/// 계획 카드. 「예산」·「한도」가 아니라 계획 카드다 (용어 고정)
model PlanCard {
  id          String     @id @default(uuid()) @db.Uuid
  childId     String     @map("child_id") @db.Uuid
  /// 어디서 — 필수
  whereText   String     @map("where_text")
  /// 업종 — 필수. 사전은 DAT-004 가 채운다
  category    String
  /// 얼마까지 — 필수
  limitAmount Int        @map("limit_amount")
  /// 무엇을 — 선택
  items       String?
  author      PlanAuthor
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  spendings SpendingRecord[]

  @@index([childId, createdAt])
  @@map("plan_cards")
  @@schema("activity")
}

/// 계획↔실제 대조와 두 갈래 회고
model SpendingRecord {
  id               String           @id @default(uuid()) @db.Uuid
  planCardId       String?          @map("plan_card_id") @db.Uuid
  childId          String           @map("child_id") @db.Uuid
  actualAmount     Int              @map("actual_amount")
  merchantCategory String           @map("merchant_category")
  /// 🔴 ⭐ 판정은 **금액 단독**이다 (ADR-008)
  matchResult      PlanMatchResult  @map("match_result")
  /// 업종 일치는 회고 문장을 분기할 뿐 ⭐를 차단하지 않는다
  categoryMatch    CategoryMatch?   @map("category_match")
  /// 회고 문장 풀에서 **비복원 추출**한 id — 재노출률을 재려면 어느 문장인지 남아야 한다
  sentenceId       String?          @map("sentence_id")
  occurredAt       DateTime         @map("occurred_at") @db.Timestamptz(6)

  planCard PlanCard? @relation(fields: [planCardId], references: [id])

  @@index([childId, occurredAt])
  @@map("spending_records")
  @@schema("activity")
}

/// 위시리스트 — 30·70·100% 단계 보상. 순위 변경은 월 1회
model Wishlist {
  id             String    @id @default(uuid()) @db.Uuid
  childId        String    @map("child_id") @db.Uuid
  name           String
  targetAmount   Int       @map("target_amount")
  savedAmount    Int       @default(0) @map("saved_amount")
  rank           Int
  /// 도달한 단계 [30, 70] — 같은 단계에 두 번 지급하지 않기 위한 기록
  reachedSteps   Json      @default("[]") @map("reached_steps")
  rankChangedAt  DateTime? @map("rank_changed_at") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([childId, rank])
  @@map("wishlists")
  @@schema("activity")
}

/// 인앱 이벤트 10종.
/// 🔴 주차 파티셔닝은 raw SQL 마이그레이션이 관리한다 (DAT-002 · REQ-TEC-004 예외).
///    Prisma 는 **읽기 모델만** 매핑한다.
model AppEvent {
  id             String   @id @default(uuid()) @db.Uuid
  eventType      String   @map("event_type")
  childId        String?  @map("child_id") @db.Uuid
  guardianId     String?  @map("guardian_id") @db.Uuid
  /// 🔴 주차 귀속은 **client_ts 기준**이다. 오프라인 이벤트가 재연결된 주로 넘어가면 안 된다
  clientTs       DateTime @map("client_ts") @db.Timestamptz(6)
  serverTs       DateTime @default(now()) @map("server_ts") @db.Timestamptz(6)
  idempotencyKey String   @map("idempotency_key")
  payload        Json

  @@unique([idempotencyKey, clientTs])
  @@index([eventType, clientTs])
  @@index([childId, clientTs])
  @@map("app_events")
  @@schema("activity")
}

// ─────────────────────────────────────────────────────────────
// dev_auth 스키마 — 🔴 로컬 전용. Supabase Auth 대체물
//
// 이관 시 이 두 모델과 `schemas` 배열의 "dev_auth" 를 지우고
// `guardian-session.ts` 를 Supabase 클라이언트로 바꾼다.
// `GuardianAccount.authRef` 의 의미는 바뀌지 않는다 — 「인증 시스템의 사용자 id」.
// ─────────────────────────────────────────────────────────────

/// 보호자만 존재한다. 아동은 자격증명이 없으므로 행이 생기지 않는다 (REQ-NF-011 · S5)
model DevAuthUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  /// scrypt · `salt:derivedKey`. 원문 비밀번호는 어디에도 저장하지 않는다
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions DevAuthSession[]

  @@map("users")
  @@schema("dev_auth")
}

/// 기기 세션과 같은 규율 — 원문 토큰은 쿠키에만, 서버에는 해시만
model DevAuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  /// 🔴 기기 세션(180일)보다 짧다. 부모 세션이 죽어도 아이 기기는 열린다 (D5-b)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user DevAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("dev_auth")
}

/// 아이 온보딩 진행 — 어긋남 대장 D13.
/// 🔴 **아이는 설명을 들은 적이 없다.** 기기 토큰으로 열면 바로 방이 나온다.
///    「했어요」를 눌러도 별이 바로 안 붙는다는 걸 모르면 고장 난 걸로 느낀다 (AC-6.2).
/// 🔴 단계를 서버에 둔다. 아이 기기는 초기화될 수 있다 — localStorage 는 남지 않는다.
model ChildOnboarding {
  childId    String    @id @map("child_id") @db.Uuid
  /// 마지막으로 **본** 단계. 0 부터 센다
  step       Int       @default(0)
  /// 끝까지 봤다. 별 1개(ONBOARDING_LEARN)는 이때 한 번만 붙는다
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  /// 건너뛰었다. 별은 없지만 다시 막지 않는다
  skippedAt  DateTime? @map("skipped_at") @db.Timestamptz(6)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("child_onboarding")
  @@schema("activity")
}
