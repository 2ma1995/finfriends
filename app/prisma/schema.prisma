// 핀프렌즈 데이터 모델
//
// 근거 — SRS §6.2 데이터 모델 · [Diagrams] ERD · DAT-001 · DAT-002 · INF-003
//
// 🔴 이 파일은 규제 항목 4가지를 **구조로** 지킨다. 나중에 고칠 수 있는 것이 아니다.
//   ① 스키마 2분할  identity(식별정보) / activity(학습·실천) — 결합 조회 0건 (REQ-NF-009 · S3)
//   ② 금지 필드 부재 좌표 0 · 얼굴 이미지 0 (REQ-TEC-009 · S1 · S2)
//   ③ 별↔저금통 전환 경로 부재 — 전환 필드·심볼 0건 (P-21 · S4)
//   ④ 멱등 키       별 원장·이벤트에 unique — 중복 지급 0건 (REQ-NF-006 · REQ-TEC-011)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 🔴 접속 URL 은 여기 두지 않는다 — Prisma 7 부터 `prisma.config.ts` 가 갖는다.
  //    앱은 풀러(트랜잭션 모드), 마이그레이션은 직결로 나눈다.
  //    같은 커넥션을 쓰면 풀러의 트랜잭션 모드에서 마이그레이션이 깨진다 (ADR-T04 · REQ-TEC-005)
  // 🔴 `dev_auth` 는 로컬 전용이다. Supabase 이관 때 이 배열에서 빼고 스키마를 버린다 (CON-001)
  schemas = ["identity", "activity", "dev_auth"]
}

// ─────────────────────────────────────────────────────────────
// 열거형 — SRS §6.2. 값을 늘리면 화면·판정·계측 세 곳이 함께 바뀐다
// ─────────────────────────────────────────────────────────────

/// 학습·나무·실천이 공유하는 고정 4영역 (§6.2.1)
enum LearningTopic {
  EARN
  SPEND
  SAVE
  GROW

  @@schema("activity")
}

/// ⭐ 지급 트리거 8종 (§6.2.2). 코드가 곧 WPA 분모/분자 구분의 근거다
enum StarTrigger {
  ONBOARDING_LEARN
  ATTENDANCE
  QUIZ_CORRECT
  MISSION_APPROVED
  SPENDING_RETRO
  WISHLIST_REACHED
  SAVINGS_JOINED
  SAVINGS_DONE
  /// 🔴 SRS §6.2.2 에 없던 코드 — 어긋남 대장 D8.
  ///    `REQ-FUNC-004` 가 「별은 차감형」이라 하고 `STR-003` 이 「옷장 차감 기입」을 요구하는데
  ///    트리거 8종이 전부 지급용이라 차감을 적을 자리가 없었다.
  ///    나가는 곳은 **앱 내 재화뿐**이다 — P-21(현금·저금통 분리)은 그대로다
  WARDROBE_SPEND

  @@schema("activity")
}

/// 경로 구분이 **북극성 지표 산출의 기준**이다.
/// 학습 경로를 분자에 넣으면 접속만으로 오르는 활동량 지표로 퇴화한다 (§6.2.2)
enum TriggerPath {
  LEARNING
  PRACTICE

  @@schema("activity")
}

/// 미션 승인 상태 (§6.2.4).
/// BACKFILLED = ⭐는 지급하되 나무 조건은 **완료 시점 주기**에 귀속 (ACE-6.2)
enum ApprovalState {
  PENDING
  APPROVED
  BACKFILLED
  REJECTED
  /// 🔴 **72시간 동안 아무도 판정하지 않았다** — `FR-032` · 어긋남 대장 D37.
  ///
  ///    거절이 **아니다.** 아이는 「했어요」를 눌렀고 부모가 못 봤을 뿐이다.
  ///    아이 화면은 **「확인하지 못했어요」**로 말한다 — 「거절」로 보이면
  ///    아이는 한 일을 부정당한 것으로 읽는다.
  ///
  ///    `AC-032-3` — 「미실천」으로 집계되지 않으나 **WPA 분모에서도 제외되지 않는다.**
  ///    부모가 못 본 것도 이 제품이 책임질 몫이라 분모에 남긴다.
  EXPIRED

  @@schema("activity")
}

/// 계획↔실제 판정 (§6.2.5). ⭐ 판정은 **금액 단독**이다 (ADR-008)
enum PlanMatchResult {
  MET
  EXCEEDED
  NO_PLAN

  @@schema("activity")
}

/// 업종 일치는 회고 문장을 분기하는 **관측 항목**이며 ⭐를 차단하지 않는다
enum CategoryMatch {
  MATCHED
  MISMATCHED

  @@schema("activity")
}

/// 계획 카드를 적은 주체 — 보호자가 대신 적어도 기록에 남는다
enum PlanAuthor {
  GUARDIAN
  CHILD

  @@schema("activity")
}

/// 기기 모드 — 🔴 SRS 에 없던 개념. 어긋남 대장 D5 참조.
///
/// `REQ-NF-011`(아동 독립 자격증명 없음)을 지키면서 **아이 폰에서 아이 화면만 열리게** 하는 장치다.
/// 아이 기기에도 살아 있는 것은 **보호자 세션**이므로, 막지 않으면 아이가 승인·결제 화면에 들어간다.
enum DeviceMode {
  /// 보호자 기기 — 전 화면
  GUARDIAN
  /// 아이 기기 — `/parent/**` 를 **서버가 차단**한다. 해제는 보호자 PIN
  CHILD

  @@schema("identity")
}

/// 🔴 시연용 가짜 카드 단계 (어긋남 대장 D15). PTN-001 착수 시 이 열거형을 버린다.
///    실제 발급은 제휴사가 하고 D1 · D-03 이 미확정이다.
enum MockCardStatus {
  /// 신청 접수
  REQUESTED
  /// 본인 확인 — 실제로는 제휴사가 한다 (D-03 · ADR-T09)
  VERIFIED
  /// 배송 중. 이 동안에도 학습·퀴즈는 열린다 (US-8 AC2 · F16)
  SHIPPING
  /// 사용 중
  ACTIVE

  @@schema("identity")
}

/// 동의·계정 상태 (SM-01). 아동 화면은 ACTIVE 에서만 열린다
enum AccountState {
  CREATED
  CONSENT_PENDING
  ACTIVE
  BLOCKED
  TERMINATED

  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────
// identity 스키마 — 아동 식별정보. activity 와 **조인하지 않는다**
// ─────────────────────────────────────────────────────────────

model GuardianAccount {
  id               String    @id @default(uuid()) @db.Uuid
  /// Supabase Auth 사용자 참조. 비밀번호·이메일을 여기 복제하지 않는다
  authRef          String    @unique @map("auth_ref")
  /// 🔴 법정대리인 동의. 서버가 판정하며 클라이언트가 캐시하지 않는다 (ACE-8.2 · S6)
  consentCompleted Boolean   @default(false) @map("consent_completed")
  consentAt        DateTime? @map("consent_at") @db.Timestamptz(6)
  /// 알림 발송 허용 시간대 — "21:00-08:00" 형식
  notifyWindow     String?   @map("notify_window")
  /// 🔴 아동 모드를 **푸는** 열쇠. 해시만 저장한다 (D5)
  ///    재로그인이 아니라 PIN 인 이유 — 아이 폰에서 보호자 비밀번호를 매번 치게 하면
  ///    아이가 그 비밀번호를 알게 된다
  childModePinHash String?   @map("child_mode_pin_hash")
  /// 🔴 **카드가 아니다.** 시연용 가짜 발급 상태다 (어긋남 대장 D15).
  ///    실제 발급은 제휴사(PTN-001)가 하고 D1·D-03 이 미확정이라 만들 수 없다.
  ///    카드번호·유효기간·CVC·실명·계좌는 **어디에도 저장하지 않는다.**
  ///    PTN-001 착수 시 이 컬럼을 버린다.
  mockCardIssuedAt DateTime? @map("mock_card_issued_at") @db.Timestamptz(6)
  /// 🔴 가짜 신청 단계. null 이면 아직 신청하지 않았다
  mockCardStatus MockCardStatus? @map("mock_card_status")
  /// 부모가 주는 이자율(%). §9 A3. 🔴 지급 주기는 D6 미결이라 계산하지 않는다
  /// 🔴 여기 **금액은 두지 않는다.** 용돈 잔액은 activity.allowance_ledger 의 합이다 —
  ///    identity 에 금액을 두면 결합 조회 차단(REQ-NF-009 · S3)이 무의미해지고,
  ///    보호자 단위라 아이가 둘이면 구분되지 않는다. 이자율은 금액이 아니라 설정이다.
  savingsInterestPct Int?        @map("savings_interest_pct")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  children ChildAccount[]
  devices  DeviceSession[]

  @@map("guardian_accounts")
  @@schema("identity")
}

model ChildAccount {
  id         String       @id @default(uuid()) @db.Uuid
  guardianId String       @map("guardian_id") @db.Uuid
  /// 이름은 화면 표기용 최소 항목. 실명 확인 대상이 아니다
  displayName String      @map("display_name")
  /// 생년만 받는다. 생년월일 전체를 받지 않는다 (수집 최소화)
  birthYear  Int          @map("birth_year")
  /// 모집 분류 전용. 기기 식별자가 아니다
  deviceType String?      @map("device_type")
  state      AccountState @default(CONSENT_PENDING)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  guardian GuardianAccount @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  // 🔴 activity 쪽으로 가는 관계를 **의도적으로 두지 않는다.**
  //    Prisma 관계를 걸면 조인이 가능해지고 REQ-NF-009(결합 조회 0건)가 깨진다.
  //    화면이 이름을 필요로 하면 **애플리케이션 계층에서 합친다** (ADR-T03).

  @@index([guardianId])
  @@map("child_accounts")
  @@schema("identity")
}

/// 기기 등록 — 🔴 SRS 에 없던 표 (D5).
///
/// 「이 기기는 아이 것」을 **서버가 안다.** 쿠키만으로 두면 지우면 그만이다.
/// `S5` 감사가 「아동 모드 기기에서 보호자 경로 시도」를 여기서 센다.
/// 아이 앱 초대 — `FR-002` · 어긋남 대장 D33.
///
/// 🔴 **기기 토큰과 다른 것이다.** 링크에 실려 나가는 것은 **한 번 쓰면 죽는 짧은 코드**이고,
///    기기 토큰(`device_sessions.token_hash`)은 그 코드를 교환해서 **그 자리에서 새로 발급**된다.
///    한동안 기기 토큰 자체를 주소에 실었다 — 180일짜리 자격증명이 브라우저 기록 ·
///    서버 로그 · 링크 미리보기에 남았다 (`D24` 가 지적한 것).
///
/// 🔴 **원문을 저장하지 않는다.** 해시만 남기므로 DB 가 새도 링크는 새지 않는다.
/// 🔴 **소진은 원자적이어야 한다.** 두 기기가 같은 링크를 동시에 열면 한 쪽만 성립해야 한다.
model ChildInvite {
  id         String    @id @default(uuid()) @db.Uuid
  guardianId String    @map("guardian_id") @db.Uuid
  childId    String    @map("child_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  /// 🔴 **24시간**. 링크는 오래 살수록 위험하다 (`FR-002`)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  /// 소진 시각. 값이 있으면 다시 쓸 수 없다
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([guardianId, childId])
  @@map("child_invites")
  @@schema("identity")
}

model DeviceSession {
  id         String     @id @default(uuid()) @db.Uuid
  guardianId String     @map("guardian_id") @db.Uuid
  /// 기기를 가리키는 무작위 값. 기기 고유 식별자를 수집하지 않는다
  deviceRef  String     @unique @map("device_ref")
  mode       DeviceMode @default(GUARDIAN)
  /// 아동 모드일 때 이 기기가 여는 아이. GUARDIAN 모드면 null
  childId    String?    @map("child_id") @db.Uuid
  /// 보호자 경로 진입 시도 누적 — 1건 이상이면 S5 알림 대상
  blockedAttempts Int   @default(0) @map("blocked_attempts")

  /// 🔴 기기 토큰의 **해시**. 원문은 쿠키에만 있고 서버에 남기지 않는다
  ///    이 토큰은 `/child/**` 만 연다. 보호자 권한을 전혀 갖지 않는다
  tokenHash  String?    @unique @map("token_hash")
  /// 보호자 세션보다 **길다.** 부모가 옆에 없어도 아이가 계속 쓸 수 있어야 한다
  expiresAt  DateTime?  @map("expires_at") @db.Timestamptz(6)
  /// 보호자가 「이 기기 해제」를 누른 시각. 값이 있으면 즉시 무효다
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(6)

  lastSeenAt DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  guardian GuardianAccount @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
  @@map("device_sessions")
  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────
// activity 스키마 — 학습·실천·별·나무·숲·계획·소비·위시리스트·이벤트
//
// 🔴 childId 는 **FK 가 아니다.** identity 와 관계를 걸지 않기 위한 의도적 선택이다.
//    참조 무결성은 애플리케이션 계층과 해지 배치가 책임진다.
// ─────────────────────────────────────────────────────────────

model LearningProgress {
  id             String        @id @default(uuid()) @db.Uuid
  childId        String        @map("child_id") @db.Uuid
  topic          LearningTopic
  completedCount Int           @default(0) @map("completed_count")
  /// 🔴 읽은 편의 id. 개수만 세면 같은 편을 다시 읽어도 진도가 오른다
  completedLessons String[]    @default([]) @map("completed_lessons")
  quizCorrect    Int           @default(0) @map("quiz_correct")
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([childId, topic])
  @@map("learning_progress")
  @@schema("activity")
}

/// 미션 — PRC-001.
///
/// 🔴 **아이가 하고 보호자가 승인한다.** 이 표가 없으면 부모 화면의 「승인 대기 N건」이
///    영원히 0이고, 별을 받는 주된 길(MISSION_APPROVED)이 막힌다.
///
/// 🔴 `cycleId` 는 **완료 시점 주기**다. 지연 승인이 다음 주기 나무를 부풀리지 않게(ACE-6.2).
/// 미션 사진 — `FR-032` · 어긋남 대장 D32.
///
/// 🔴 **판정과 함께 사라진다.** 보호자가 승인·반려를 누르는 순간, 그리고 72시간 만료
///    배치에서 지운다. `AC-032-2` 의 검증이 「스토리지 스캔 0건」이라 **파기를 증명할 수
///    있어야** 한다 — 파일이면 지웠는지 확인이 어렵고 표면 한 줄로 셀 수 있다.
///
/// 🔴 이전 사양에서는 이 기능이 **제외**였다(아동 이미지 리스크). 새 SRS 가 「판정 즉시
///    파기」를 조건으로 달아 다시 넣었고, 사용자가 리스크를 듣고 승인했다.
///
/// 🔴 `activity` 에 둔다. 아이 얼굴이 들어갈 수 있지만 **미션에 잠깐 붙는 증거**이고
///    `mission_id` 로만 잡으므로 `identity` 와 조인하지 않는다 (`REQ-NF-009`).
///    `CON-07`(아동 이미지 서버 미보관)은 **영구 보관 금지**로 읽는다 — 판정까지가 한계다.
model MissionPhoto {
  missionId String   @id @map("mission_id") @db.Uuid
  bytes     Bytes
  /// image/jpeg · image/png · image/webp 만 받는다
  mime      String
  byteSize  Int      @map("byte_size")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("mission_photos")
  @@schema("activity")
}

model Mission {
  id          String        @id @default(uuid()) @db.Uuid
  childId     String        @map("child_id") @db.Uuid
  /// 만든 사람 — 보호자가 조건·보상을 미리 정한다 (PRC-001)
  guardianId  String        @map("guardian_id") @db.Uuid
  title       String
  topic       LearningTopic
  /// 🔴 ⭐ 개수. `REQ-FUNC-002` 가 **1로 못박았다** — 값은 금액으로 매긴다
  reward      Int           @default(1)
  /// 🔴 보호자가 미션에 건 **금액(원)**. 승인 시 용돈 원장에 들어간다.
  ///    미션은 「벌기」의 실체다 — 심부름하고 용돈을 받는 것이 아이가 겪는 유일한 「버는」 경험이다.
  ///    별↔현금 전환이 아니다(P-21). 보호자가 일한 대가로 주는 것이고 실제 돈은 앱 밖에서 오간다
  payoutWon   Int           @default(0) @map("payout_won")
  state       ApprovalState @default(PENDING)
  /// 아이가 「했어요」를 누른 시각. null 이면 아직 안 함
  doneAt      DateTime?     @map("done_at") @db.Timestamptz(6)
  /// 보호자가 승인·거절한 시각
  decidedAt   DateTime?     @map("decided_at") @db.Timestamptz(6)
  /// 거절 사유 — 「미실천」과 구별해 보여준다
  rejectReason String?      @map("reject_reason")
  /// 완료 시점 주기. 승인이 늦어도 이 주기에 귀속된다
  cycleId     Int?          @map("cycle_id")
  /// 🔴 언제 사진을 지웠는지. 사진 자체는 `mission_photos` 가 갖고 판정 즉시 사라진다.
  ///    행이 사라지면 증명이 「없다」뿐이라, **「언제 지웠다」**를 남긴다 (FR-032 · AC-032-2)
  photoErasedAt DateTime?   @map("photo_erased_at") @db.Timestamptz(6)

  /// 학습 편 id. 🔴 null 이면 보호자가 만든 미션, 값이 있으면 **아이가 배우고 스스로 한 것**.
  ///    한 편당 한 장이다 — 부분 유니크 인덱스가 DB 에서 막는다
  sourceId    String?       @map("source_id")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([childId, state])
  @@index([guardianId, state])
  @@map("missions")
  @@schema("activity")
}

/// 실천 인정. 나무 승급의 **유일한** 근거다 — 학습·퀴즈로는 대체되지 않는다 (ADR-006)
model PracticeCredit {
  id           String      @id @default(uuid()) @db.Uuid
  childId      String      @map("child_id") @db.Uuid
  triggerCode  StarTrigger @map("trigger_code")
  triggerPath  TriggerPath @map("trigger_path")
  topic        LearningTopic?
  /// auto = 자동 판정 · parent = 보호자 승인
  approvalMode String      @map("approval_mode")
  /// 아이가 **실제로 한** 시각
  earnedAt     DateTime    @map("earned_at") @db.Timestamptz(6)
  /// ⭐가 **확정된** 시각. 소급 승인이면 둘이 다르다
  awardedAt    DateTime    @map("awarded_at") @db.Timestamptz(6)
  /// 🔴 귀속 주기를 별도 컬럼으로 둔다. 지급 시각으로 계산하면
  ///    소급 승인이 **다음 주기 나무를 부풀린다** (ACE-6.2)
  cycleId      Int         @map("cycle_id")

  starEntry StarLedgerEntry?

  @@index([childId, cycleId])
  @@index([childId, earnedAt])
  @@map("practice_credits")
  @@schema("activity")
}

/// 별 원장. 잔액을 따로 두지 않고 **원장의 합**이 잔액이다 — 정합성 오류율 0% (REQ-NF-006)
model StarLedgerEntry {
  id           String      @id @default(uuid()) @db.Uuid
  childId      String      @map("child_id") @db.Uuid
  /// 증감. 옷장 구매는 음수. 🔴 **현금·저금통으로 나가는 값은 없다** (P-21)
  delta        Int
  triggerCode  StarTrigger @map("trigger_code")
  /// 기입 직후 잔액 — 정합성 검사가 이 값과 누적합을 대조한다
  balanceAfter Int         @map("balance_after")
  /// 🔴 중복 지급 0건을 보증하는 유일한 장치. 오프라인 큐가 재전송해도 한 번만 들어간다
  idempotencyKey String    @unique @map("idempotency_key")
  practiceId   String?     @unique @map("practice_id") @db.Uuid
  /**
   * 🔴 **정합성이 깨진 줄** — `FR-012` · `AC-012-3` · 어긋남 대장 D39.
   *    누적합과 `balanceAfter` 가 어긋난 줄에 표시만 한다.
   *    **잔액은 건드리지 않는다** — 「아동의 잔액은 감소하지 않으며」가 요구다.
   *    아이가 잘못한 게 아닌데 별을 뺏으면 그 화면을 다시는 못 믿는다.
   */
  quarantinedAt DateTime?  @map("quarantined_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  practice PracticeCredit? @relation(fields: [practiceId], references: [id])

  @@index([childId, createdAt])
  @@map("star_ledger")
  @@schema("activity")
}

/// 영역당 1행 = 아동당 4행. 주기마다 초기화되는 것은 **나무뿐**이다
model TreeState {
  id            String        @id @default(uuid()) @db.Uuid
  childId       String        @map("child_id") @db.Uuid
  slot          LearningTopic
  /// 🔴 단계 수는 **D6 미결**이다. 정수로 두고 판정 로직이 상한을 갖는다
  stage         Int           @default(0)
  condLearn     Boolean       @default(false) @map("cond_learn")
  condQuiz      Boolean       @default(false) @map("cond_quiz")
  /// 이 값이 0이면 학습·퀴즈를 초과 충족해도 승급하지 않는다
  practiceCount Int           @default(0) @map("practice_count")
  cycleStartedAt DateTime     @map("cycle_started_at") @db.Date
  /// 14일이면 정체. 원인은 조건 단위로 **전부** 표시한다 (ACE-3.1)
  stallDays     Int           @default(0) @map("stall_days")
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([childId, slot])
  @@map("tree_states")
  @@schema("activity")
}

/// 월간 숲. 나무와 달리 **초기화되지 않는다** — 누적 증거다
model ForestSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  childId      String   @map("child_id") @db.Uuid
  /// "2026-03"
  yearMonth    String   @map("year_month")
  finalStages  Json     @map("final_stages")
  /// 전월 대비 델타 7항목 (REQ-FUNC-009)
  deltaItems   Json     @map("delta_items")
  /// 별을 즉시 소진하는 아이에게 **유일한 누적 증거**다 (AC-1.4)
  starsEarned  Int      @map("stars_earned")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([childId, yearMonth])
  @@map("forest_snapshots")
  @@schema("activity")
}

/// 계획 카드. 「예산」·「한도」가 아니라 계획 카드다 (용어 고정)
model PlanCard {
  id          String     @id @default(uuid()) @db.Uuid
  childId     String     @map("child_id") @db.Uuid
  /// 어디서 — 필수
  whereText   String     @map("where_text")
  /// 업종 — 필수. 사전은 DAT-004 가 채운다
  category    String
  /// 얼마까지 — 필수
  limitAmount Int        @map("limit_amount")
  /// 무엇을 — 선택
  items       String?
  author      PlanAuthor
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  spendings SpendingRecord[]

  @@index([childId, createdAt])
  @@map("plan_cards")
  @@schema("activity")
}

/// 계획↔실제 대조와 두 갈래 회고
/// 🔴 **계획 카드 시절의 소비 기록이다.** 봉투(`FR-020`·`FR-021`)가 그 자리를 가져가면서
///    **새 기록은 여기 쌓이지 않는다** — `envelope_spends` 로 간다.
///    표를 남기는 이유는 옛 기록이 들어 있고 부모 소비 내역이 그것을 읽기 때문이다.
model SpendingRecord {
  id               String           @id @default(uuid()) @db.Uuid
  planCardId       String?          @map("plan_card_id") @db.Uuid
  childId          String           @map("child_id") @db.Uuid
  actualAmount     Int              @map("actual_amount")
  merchantCategory String           @map("merchant_category")
  /// 🔴 ⭐ 판정은 **금액 단독**이다 (ADR-008)
  matchResult      PlanMatchResult  @map("match_result")
  /// 업종 일치는 회고 문장을 분기할 뿐 ⭐를 차단하지 않는다
  categoryMatch    CategoryMatch?   @map("category_match")
  /// 회고 문장 풀에서 **비복원 추출**한 id — 재노출률을 재려면 어느 문장인지 남아야 한다
  sentenceId       String?          @map("sentence_id")
  occurredAt       DateTime         @map("occurred_at") @db.Timestamptz(6)

  planCard PlanCard? @relation(fields: [planCardId], references: [id])

  @@index([childId, occurredAt])
  @@map("spending_records")
  @@schema("activity")
}

/// 위시리스트 — 30·70·100% 단계 보상. 순위 변경은 월 1회
model Wishlist {
  id             String    @id @default(uuid()) @db.Uuid
  childId        String    @map("child_id") @db.Uuid
  name           String
  targetAmount   Int       @map("target_amount")
  savedAmount    Int       @default(0) @map("saved_amount")
  rank           Int
  /// 도달한 단계 [30, 70] — 같은 단계에 두 번 지급하지 않기 위한 기록
  reachedSteps   Json      @default("[]") @map("reached_steps")
  rankChangedAt  DateTime? @map("rank_changed_at") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([childId, rank])
  @@map("wishlists")
  @@schema("activity")
}

/// 인앱 이벤트 10종.
/// 🔴 주차 파티셔닝은 raw SQL 마이그레이션이 관리한다 (DAT-002 · REQ-TEC-004 예외).
///    Prisma 는 **읽기 모델만** 매핑한다.
model AppEvent {
  id             String   @id @default(uuid()) @db.Uuid
  eventType      String   @map("event_type")
  childId        String?  @map("child_id") @db.Uuid
  guardianId     String?  @map("guardian_id") @db.Uuid
  /// 🔴 주차 귀속은 **client_ts 기준**이다. 오프라인 이벤트가 재연결된 주로 넘어가면 안 된다
  clientTs       DateTime @map("client_ts") @db.Timestamptz(6)
  serverTs       DateTime @default(now()) @map("server_ts") @db.Timestamptz(6)
  idempotencyKey String   @map("idempotency_key")
  payload        Json

  @@unique([idempotencyKey, clientTs])
  @@index([eventType, clientTs])
  @@index([childId, clientTs])
  @@map("app_events")
  @@schema("activity")
}

// ─────────────────────────────────────────────────────────────
// dev_auth 스키마 — 🔴 로컬 전용. Supabase Auth 대체물
//
// 이관 시 이 두 모델과 `schemas` 배열의 "dev_auth" 를 지우고
// `guardian-session.ts` 를 Supabase 클라이언트로 바꾼다.
// `GuardianAccount.authRef` 의 의미는 바뀌지 않는다 — 「인증 시스템의 사용자 id」.
// ─────────────────────────────────────────────────────────────

/// 보호자만 존재한다. 아동은 자격증명이 없으므로 행이 생기지 않는다 (REQ-NF-011 · S5)
model DevAuthUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  /// scrypt · `salt:derivedKey`. 원문 비밀번호는 어디에도 저장하지 않는다
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions DevAuthSession[]

  @@map("users")
  @@schema("dev_auth")
}

/// 기기 세션과 같은 규율 — 원문 토큰은 쿠키에만, 서버에는 해시만
model DevAuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  /// 🔴 기기 세션(180일)보다 짧다. 부모 세션이 죽어도 아이 기기는 열린다 (D5-b)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user DevAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("dev_auth")
}

/// 아이 온보딩 진행 — 어긋남 대장 D13.
/// 🔴 **아이는 설명을 들은 적이 없다.** 기기 토큰으로 열면 바로 방이 나온다.
///    「했어요」를 눌러도 별이 바로 안 붙는다는 걸 모르면 고장 난 걸로 느낀다 (AC-6.2).
/// 🔴 단계를 서버에 둔다. 아이 기기는 초기화될 수 있다 — localStorage 는 남지 않는다.
model ChildOnboarding {
  childId    String    @id @map("child_id") @db.Uuid
  /// 마지막으로 **본** 단계. 0 부터 센다
  step       Int       @default(0)
  /// 끝까지 봤다. 별 1개(ONBOARDING_LEARN)는 이때 한 번만 붙는다
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  /// 건너뛰었다. 별은 없지만 다시 막지 않는다
  skippedAt  DateTime? @map("skipped_at") @db.Timestamptz(6)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("child_onboarding")
  @@schema("activity")
}

/// 아이가 가진 아이템 — 어긋남 대장 D14.
/// 🔴 이 표가 없어서 방·상점이 브라우저 localStorage 를 지갑처럼 썼다.
///    별 원장에 차감은 남는데 **무엇을 샀는지가 없어** 원장과 화면이 서로 몰랐다.
model ChildItem {
  childId    String   @map("child_id") @db.Uuid
  /// 카탈로그의 아이템 id. 카탈로그 자체는 코드다 — 에셋 정의이지 회원 데이터가 아니다
  itemId     String   @map("item_id")
  /// 살 때 실제로 낸 별. 나중에 값이 바뀌어도 그때 낸 값이 남는다
  cost       Int      @default(0)
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(6)

  @@id([childId, itemId])
  @@map("child_items")
  @@schema("activity")
}

/// 방 상태 — 아이당 한 줄. 무엇을 입고, 무엇을 어디에 놓았는가.
/// 🔴 `layout` 은 위치 정보가 아니라 **화면 좌표**다. 컬럼으로 펼치면
///    이름만 보고 위치정보로 오해될 수 있어 JSON 한 칸에 둔다.
model ChildRoom {
  childId     String   @id @map("child_id") @db.Uuid
  characterId String   @default("char-fb") @map("character_id")
  wear        String[] @default([])
  layout      Json     @default("{}")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("child_room")
  @@schema("activity")
}

/// 용돈 장부의 한 줄 — 어긋남 대장 D18.
enum AllowanceCode {
  /// 보호자가 용돈을 줬다고 적는다 (+)
  TOPUP
  /// 아이가 목표에 떼어 두었다 (−)
  WISH_SET_ASIDE
  /// 목표를 지워 되돌렸다 (+)
  WISH_RELEASE
  /// 계획대로 쓴 것을 적었다 (−)
  PLAN_SPEND
  /// 보호자가 잘못 적은 것을 고쳤다 (±)
  ADJUST
  /// 우리 집 적금으로 묶었다 (−)
  SAVINGS_LOCK
  /// 적금이 끝나 돌아왔다 — 원금(+이자) (+)
  SAVINGS_RELEASE

  @@schema("activity")
}

/// 용돈 장부 — 어긋남 대장 D18.
/// 🔴 **앱은 돈을 보관하지 않는다.** 실제 돈은 앱 밖에 있고 여기는 장부다 —
///    가치를 보관하면 선불전자지급수단이 되어 전자금융업 등록 대상이 된다.
/// 🔴 **별과 섞이지 않는다** (P-21 · S4). 두 원장 사이에 전환 함수를 두지 않는다.
/// 🔴 잔액을 따로 저장하지 않는다. 합이 잔액이다.
model AllowanceEntry {
  id             String        @id @default(uuid()) @db.Uuid
  childId        String        @map("child_id") @db.Uuid
  delta          Int
  code           AllowanceCode
  /// 아이가 화면에서 읽을 한 줄
  memo           String?
  /// 🔴 같은 조작이 두 번 들어와도 한 번만 적힌다 (REQ-NF-003)
  idempotencyKey String        @unique @map("idempotency_key")
  balanceAfter   Int           @map("balance_after")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([childId, createdAt(sort: Desc)])
  @@map("allowance_ledger")
  @@schema("activity")
}

/// 카드 거래가 어디서 왔나 — 어긋남 대장 D19.
enum TxnSource {
  /// 🔴 연동 전 **예시 데이터**. 화면이 그 사실을 밝힌다
  MOCK
  /// 제휴 카드사에서 실제로 받은 것 (DAT-004)
  LINKED

  @@schema("activity")
}

/// 카드 거래 내역 — 어긋남 대장 D19.
/// 🔴 **손입력을 대체하지 않는다.** 아이가 스스로 적는 것이 학습이고 여기는 **대조용**이다.
/// 🔴 자금은 카드사가 보관한다. 앱은 내역만 받는다 — D18 의 선이 그대로 유지된다.
model CardTransaction {
  id         String    @id @default(uuid()) @db.Uuid
  childId    String    @map("child_id") @db.Uuid
  amount     Int
  merchant   String
  /// 🔴 가맹점 업종 코드(ISO 18245). **실제 카드가 보내는 값**이다
  mcc        String?
  /// 우리 업종 — MCC 를 접은 **결과**다. 모르면 미분류로 간다
  category   String
  occurredAt DateTime  @map("occurred_at") @db.Timestamptz(6)
  source     TxnSource @default(MOCK)
  /// 🔴 한 거래는 한 번만 쓰인다. 같은 거래로 별을 두 번 받을 수 없다
  recordId   String?   @unique @map("record_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([childId, occurredAt(sort: Desc)])
  @@map("card_transactions")
  @@schema("activity")
}

/// 목돈이냐 조금씩이냐 — 어긋남 대장 D25.
/// 🔴 학습 `save-3` 이 둘을 구별해 가르친다. 앱이 반대로 말하면 배운 것이 무너진다.
enum SavingsKind {
  /// 목돈을 한 번에 넣고 만기까지 둔다
  DEPOSIT
  /// 매주 조금씩 넣는다. 🔴 **아이가 직접 넣는다** — 자동이면 실천이 아니다
  INSTALLMENT

  @@schema("activity")
}

/// 우리 집 적금의 상태 — 어긋남 대장 D25.
enum SavingsState {
  /// 아이가 신청했고 보호자를 기다린다
  REQUESTED
  /// 보호자가 받아들였다. 돈이 묶인다
  ACTIVE
  /// 만기까지 지켰다 — 원금 + 이자
  DONE
  /// 🔴 만기 전에 깼다. 원금만 돌아오고 **이자는 없다** — 자료가 가르치는 그대로다
  BROKEN
  REJECTED

  @@schema("activity")
}

/// 우리 집 적금 — 어긋남 대장 D25.
///
/// 🔴 **외부 금융기관 가입을 중개하지 않는다** (P-20 · REQ-NF-012).
///    외부 링크도 API 호출도 없다. **부모와 아이의 약속**이고 이자는 부모가 자기 돈으로 준다.
/// 🔴 이게 「불리기」 실천을 여는 유일한 길이다 — SAVINGS_JOINED(⭐1)·SAVINGS_DONE(⭐10)이
///    정의만 돼 있고 쓰는 곳이 없었다.
model SavingsPlan {
  id           String       @id @default(uuid()) @db.Uuid
  childId      String       @map("child_id") @db.Uuid
  guardianId   String       @map("guardian_id") @db.Uuid
  /// 왜 모으는지 — 목표가 없으면 금방 깬다
  goal         String
  kind         SavingsKind  @default(DEPOSIT)
  /// 예금이면 넣는 목돈, 적금이면 **다 넣었을 때의 합계**
  amount       Int
  months       Int
  /// 적금일 때 한 회에 넣는 금액
  perPeriod    Int?         @map("per_period")
  /// 적금일 때 넣어야 하는 총 회차 (주 단위)
  periods      Int?
  /// 지금까지 넣은 회차
  paidCount    Int          @default(0) @map("paid_count")
  /// 마지막으로 넣은 시각 — 「이번 주에 이미 넣었나」를 본다
  lastPaidAt   DateTime?    @map("last_paid_at") @db.Timestamptz(6)
  /// 🔴 **신청 시점 이자율을 박아 둔다.** 약속한 뒤에 조건이 바뀌면 그건 약속이 아니다.
  ///    정하는 것은 **보호자**다 — 이자는 보호자가 자기 돈으로 준다
  interestPct  Int          @default(0) @map("interest_pct")
  /// 🔴 아이가 **바란** 이자율. 실제 적용값이 아니다 —
  ///    고르게 해놓고 무시하면 안 되므로 「선택」이 아니라 **「제안」**으로 둔다
  wantedPct    Int?         @map("wanted_pct")
  state        SavingsState @default(REQUESTED)
  requestedAt  DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt    DateTime?    @map("started_at") @db.Timestamptz(6)
  maturesAt    DateTime?    @map("matures_at") @db.Timestamptz(6)
  closedAt     DateTime?    @map("closed_at") @db.Timestamptz(6)
  rejectReason String?      @map("reject_reason")

  @@index([childId, state])
  @@index([guardianId, state])
  @@map("savings_plans")
  @@schema("activity")
}

/// 봉투 — `FR-020`. 어긋남 대장 D32.
/// 🔴 **표시용 구획이다.** 실제 선불 잔액은 하나이고 앱은 배분만 보여준다.
model Envelope {
  id          String   @id @default(uuid()) @db.Uuid
  childId     String   @map("child_id") @db.Uuid
  name        String
  emoji       String   @default("📦")
  allocated   Int      @default(0)
  /// 🔴 업종 코드 목록. 결제가 오면 이걸로 봉투를 고른다
  categories  String[] @default([])
  /// 🔴 미분류 봉투 — 아이당 하나. 업종을 못 고르면 여기서 뺀다
  isDefault   Boolean  @default(false) @map("is_default")
  rank        Int      @default(0)
  /// 🔴 언제 배분했나. 잔액은 **이 시각 이후의 지출**만 센다
  allocatedAt DateTime @default(now()) @map("allocated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([childId, rank])
  @@map("envelopes")
  @@schema("activity")
}

/// 봉투에서 빠진 결제 한 건 — `FR-021`.
/// 🔴 **결제 시각의 스냅샷을 자기 안에 박아 둔다.** 사후에 봉투를 고쳐도 판정이 안 바뀐다 (AC-021-3).
model EnvelopeSpend {
  id            String    @id @default(uuid()) @db.Uuid
  childId       String    @map("child_id") @db.Uuid
  envelopeId    String?   @map("envelope_id") @db.Uuid
  /// 원본 거래. 🔴 한 거래는 한 번만 빠진다 — 웹훅이 두 번 와도 두 번 안 빠진다
  txnId         String?   @unique @map("txn_id") @db.Uuid
  merchant      String
  /// 결제 시점의 가맹점 업종 코드. 오분류를 나중에 되짚으려면 원본이 있어야 한다
  mcc           String?
  category      String
  amount        Int
  snapAllocated Int       @map("snap_allocated")
  snapRemaining Int       @map("snap_remaining")
  within        Boolean
  /// 🔴 넘긴 금액. 부모 화면이 「간식 봉투 700원 초과」를 말한다 (AC-021-2)
  overBy        Int       @default(0) @map("over_by")
  unclassified  Boolean   @default(false)
  /// 🔴 되돌려도 ⭐는 회수하지 않는다 (FR-021 예외 ③)
  refundedAt    DateTime? @map("refunded_at") @db.Timestamptz(6)
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([childId, occurredAt(sort: Desc)])
  @@map("envelope_spends")
  @@schema("activity")
}

/// 재배분 이력 — 🔴 아이가 봉투를 고치면 **부모 화면에 남는다** (`AC-020-3`).
///    다그치려는 기록이 아니라 **부모가 바뀐 걸 아는** 장치다 (P-03).
model EnvelopeChange {
  id        String   @id @default(uuid()) @db.Uuid
  childId   String   @map("child_id") @db.Uuid
  /// 바꾼 결과를 통째로 남긴다. 이름이 바뀔 수도 있어 id 만으로는 못 읽는다
  snapshot  Json
  total     Int
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([childId, changedAt(sort: Desc)])
  @@map("envelope_changes")
  @@schema("activity")
}

/// 가맹점 분류 교정 — `FR-021` 예외 ②. 어긋남 대장 D34.
/// 🔴 **사람이 한 번 본 것이 코드보다 낫다.** MCC 표는 오분류가 남고,
///    보호자가 고친 것을 기억해 다음부터 그 가게는 그 봉투에서 뺀다.
/// 🔴 **지난 결제에는 소급하지 않는다** — 옮기면 이미 내린 ⭐ 판정이 흔들린다.
model MerchantRule {
  childId   String   @map("child_id") @db.Uuid
  /// 🔴 지금은 **이름**이 키다. 실제 카드는 가맹점 ID 를 주므로 제휴 시 바꿔야 한다
  merchant  String
  category  String
  /// 무엇을 보고 정했는지 — 나중에 MCC 표를 고칠 때 근거가 된다
  seenMcc   String?  @map("seen_mcc")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([childId, merchant])
  @@map("merchant_rules")
  @@schema("activity")
}

/// 하교 시각 — 어긋남 대장 D39.
///
/// 🔴 **묻는 때를 부모가 정한다.** 「오늘 쓸 계획 있니?」는 아이가 학교에서 나온
///    직후에만 쓸모가 있다. 그 시각을 아는 것은 서버가 아니라 부모다.
model ChildSchedule {
  childId      String   @id @map("child_id") @db.Uuid
  guardianId   String   @map("guardian_id") @db.Uuid
  /// 자정 기준 분 (0–1439). 900 = 15:00
  schoolEndMin Int      @map("school_end_min")
  /// 오늘 이미 물었는지 — KST 날짜 문자열. 없으면 화면마다 다시 뜬다
  askedDay     String?  @map("asked_day")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([guardianId])
  @@map("child_schedules")
  @@schema("activity")
}
